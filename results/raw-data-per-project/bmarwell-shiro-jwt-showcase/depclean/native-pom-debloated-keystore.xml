<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.bmarwell.shiro</groupId>
    <artifactId>shiro.jwt.jaxrs.root</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>shiro.jwt.jaxrs.keystore</artifactId>
  <name>Apache Shiro + mpJWT :: keystore</name>
  <properties>
    <keystore.path>${project.basedir}/src/main/resources/io/github/bmarwell/shiro/keystore/keystore.p12</keystore.path>
    <truststore.path>${project.basedir}/src/main/resources/io/github/bmarwell/shiro/keystore/truststore.p12</truststore.path>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.opentest4j</groupId>
      <artifactId>opentest4j</artifactId>
      <version>1.3.0</version>
      <scope>test</scope>
      <optional>false</optional>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.27.4</version>
      <scope>test</scope>
      <optional>false</optional>
    </dependency>
    <dependency>
      <groupId>org.apiguardian</groupId>
      <artifactId>apiguardian-api</artifactId>
      <version>1.1.2</version>
      <scope>test</scope>
      <optional>false</optional>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-engine</artifactId>
      <version>1.13.4</version>
      <scope>test</scope>
      <optional>false</optional>
    </dependency>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
      <version>1.15.11</version>
      <scope>test</scope>
      <optional>false</optional>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>5.13.4</version>
      <scope>test</scope>
      <optional>false</optional>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-commons</artifactId>
      <version>1.13.4</version>
      <scope>test</scope>
      <optional>false</optional>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>5.13.4</version>
      <scope>test</scope>
      <optional>false</optional>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>keytool-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-keypair</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>generateKeyPair</goal>
            </goals>
            <configuration>
              <keystore>${keystore.path}</keystore>
              <dname>CN=${liberty.env.ISSUER_NAME}, OU=, O=, L=, S=, C=DE</dname>
              <keyalg>ec</keyalg>
              <keysize>256</keysize>
              <storepass>changeit</storepass>
              <keypass>changeit</keypass>
              <alias>issuer</alias>
              <skipIfExist>true</skipIfExist>
              <storetype>pkcs12</storetype>
            </configuration>
          </execution>
          <execution>
            <id>export-public-certificate</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>exportCertificate</goal>
            </goals>
            <configuration>
              <keystore>${keystore.path}</keystore>
              <file>${java.io.tmpdir}/issuer.crt</file>
              <alias>issuer</alias>
              <rfc>true</rfc>
              <storepass>changeit</storepass>
              <storetype>pkcs12</storetype>
            </configuration>
          </execution>
          <execution>
            <id>import-public-certificate</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>importCertificate</goal>
            </goals>
            <configuration>
              <keystore>${truststore.path}</keystore>
              <storepass>changeit</storepass>
              <storetype>pkcs12</storetype>
              <file>${java.io.tmpdir}/issuer.crt</file>
              <skipIfExist>true</skipIfExist>
              <noprompt>true</noprompt>
              <alias>issuer</alias>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
