{
  "category": "topology-chain-reflect",
  "description": "Chained reflection — app reflectively loads A, A reflectively loads B. Tests multi-hop reflection tracking.",
  "app_module": "d1-app",
  "dependencies": [
    {
      "artifactId": "shared-api",
      "scope": "direct",
      "usage_type": "STATIC",
      "used_at_runtime": true,
      "expected_depclean": "used_direct",
      "expected_nia": "used_direct",
      "note": "Plugin interface imported for casting"
    },
    {
      "artifactId": "d1-chain-middle",
      "scope": "direct",
      "usage_type": "REFLECTION",
      "used_at_runtime": true,
      "expected_depclean": "unused_direct",
      "expected_nia": "used_direct",
      "note": "First hop: loaded by app via Class.forName"
    },
    {
      "artifactId": "d1-chain-end",
      "scope": "transitive",
      "usage_type": "REFLECTION_TRANSITIVE",
      "used_at_runtime": true,
      "expected_depclean": "unused_transitive",
      "expected_nia": "used_transitive",
      "note": "Second hop: loaded by chain-middle via Class.forName — requires multi-hop tracking"
    },
    {
      "artifactId": "d1-transitive-unused",
      "scope": "transitive",
      "usage_type": "UNUSED",
      "used_at_runtime": false,
      "expected_depclean": "unused_transitive",
      "expected_nia": "unused_transitive",
      "note": "Truly unused transitive dependency"
    },
    {
      "artifactId": "d1-unused-direct",
      "scope": "direct",
      "usage_type": "UNUSED",
      "used_at_runtime": false,
      "expected_depclean": "unused_direct",
      "expected_nia": "unused_direct",
      "note": "Truly unused direct dependency"
    }
  ]
}
