{
  "category": "level-l4-annotation",
  "description": "Class name stored in custom annotation, read at runtime via getAnnotation() — mirrors @ConditionalOnClass, @JsonSubTypes patterns",
  "app_module": "l4-app",
  "dependencies": [
    {
      "artifactId": "shared-api",
      "scope": "direct",
      "usage_type": "STATIC",
      "used_at_runtime": true,
      "expected_depclean": "used_direct",
      "expected_nia": "used_direct",
      "note": "Plugin interface imported for casting"
    },
    {
      "artifactId": "l4-annotation-api",
      "scope": "direct",
      "usage_type": "STATIC",
      "used_at_runtime": true,
      "expected_depclean": "used_direct",
      "expected_nia": "used_direct",
      "note": "@PluginBinding annotation imported and used in source"
    },
    {
      "artifactId": "l4-impl",
      "scope": "direct",
      "usage_type": "REFLECTION",
      "used_at_runtime": true,
      "expected_depclean": "unused_direct",
      "expected_nia": "used_direct",
      "note": "Class name only in annotation value string — static analysis sees string constant but must understand annotation semantics"
    },
    {
      "artifactId": "l4-impl-helper",
      "scope": "transitive",
      "usage_type": "REFLECTION_TRANSITIVE",
      "used_at_runtime": true,
      "expected_depclean": "unused_transitive",
      "expected_nia": "used_transitive",
      "note": "Used by AnnotatedPlugin at runtime"
    },
    {
      "artifactId": "l4-transitive-unused",
      "scope": "transitive",
      "usage_type": "UNUSED",
      "used_at_runtime": false,
      "expected_depclean": "unused_transitive",
      "expected_nia": "unused_transitive",
      "note": "Truly unused"
    },
    {
      "artifactId": "l4-unused-direct",
      "scope": "direct",
      "usage_type": "UNUSED",
      "used_at_runtime": false,
      "expected_depclean": "unused_direct",
      "expected_nia": "unused_direct",
      "note": "Truly unused"
    }
  ]
}
