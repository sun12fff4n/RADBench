{
  "category": "level-l2-param-passing",
  "description": "Class name passed as method parameter to Class.forName — requires data-flow tracking",
  "app_module": "l2-app",
  "dependencies": [
    {
      "artifactId": "shared-api",
      "scope": "direct",
      "usage_type": "STATIC",
      "used_at_runtime": true,
      "expected_depclean": "used_direct",
      "expected_nia": "used_direct",
      "note": "Plugin interface imported and cast in source code"
    },
    {
      "artifactId": "l2-impl",
      "scope": "direct",
      "usage_type": "REFLECTION",
      "used_at_runtime": true,
      "expected_depclean": "unused_direct",
      "expected_nia": "used_direct",
      "note": "Class name passed as parameter — static analysis must track data flow"
    },
    {
      "artifactId": "l2-impl-helper",
      "scope": "transitive",
      "usage_type": "REFLECTION_TRANSITIVE",
      "used_at_runtime": true,
      "expected_depclean": "unused_transitive",
      "expected_nia": "used_transitive",
      "note": "Used by ParamPlugin at runtime (PluginHelper.transform), transitive via l2-impl"
    },
    {
      "artifactId": "l2-transitive-unused",
      "scope": "transitive",
      "usage_type": "UNUSED",
      "used_at_runtime": false,
      "expected_depclean": "unused_transitive",
      "expected_nia": "unused_transitive",
      "note": "Declared by l2-impl but not used by anyone at runtime"
    },
    {
      "artifactId": "l2-unused-direct",
      "scope": "direct",
      "usage_type": "UNUSED",
      "used_at_runtime": false,
      "expected_depclean": "unused_direct",
      "expected_nia": "unused_direct",
      "note": "Declared in l2-app pom but never referenced"
    }
  ]
}
